# Elite Studios Kungu — environment template
# Copy to .env.local and fill in. Never commit real secrets.

NEXT_PUBLIC_SITE_URL=https://elitestudios.ug

# Admin (demo build). Set a strong password in production.
ADMIN_PASSWORD=change-me-strong-password

# Supabase (production — see DATABASE_SCHEMA.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (production — Resend / SendGrid / etc.)
EMAIL_API_KEY=
EMAIL_FROM=no-reply@elitestudios.ug
ADMIN_EMAIL=

# WhatsApp (display number used by booking follow-up links)
NEXT_PUBLIC_WHATSAPP=256700000000
